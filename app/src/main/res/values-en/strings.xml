    <string name="adfree_browser">In the browser: the real uBlock Origin</string>
    <string name="adfree_browser_text">For websites and YouTube in the browser, install uBlock Origin inside the browser. On Android this works with Firefox.</string>
    <string name="adfree_dashboard_sub">uBlock Origin rules are active · guide for browser and YouTube</string>
