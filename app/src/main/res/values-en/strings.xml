    <string name="about">About Shield</string>
    <string name="about_text">Shield %1$s · %2$s\nOpen source (GPL-3.0). No telemetry, no accounts – everything stays on the device.\nNo protection is perfect: Shield shows exactly which layers are active and verified.</string>
